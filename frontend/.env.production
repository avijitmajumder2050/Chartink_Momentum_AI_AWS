# Staging deployment — one CloudFront distribution (dz1fb1xrtg7b3.cloudfront.net)
# fronts both the S3-hosted SPA and the EC2-hosted API (path-routed:
# /api/* and /firebase-messaging-sw.js go to the backend, everything
# else to S3) — same-origin from the browser's point of view, so
# VITE_API_BASE_URL is empty (relative paths) and no CORS is needed.
VITE_API_BASE_URL=
VITE_COGNITO_DOMAIN=quantile-auth.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=6e2925ql8rsidus8m4m45nsli0
VITE_COGNITO_REGION=ap-south-1
VITE_REDIRECT_URI=https://dz1fb1xrtg7b3.cloudfront.net/auth/callback
VITE_LOGOUT_URI=https://dz1fb1xrtg7b3.cloudfront.net/
