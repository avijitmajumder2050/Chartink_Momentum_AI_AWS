# Not secret — a public Cognito app client id + Hosted UI domain are
# inherently visible to anyone using the login flow (shipped in the JS
# bundle either way), so this is safe to commit, unlike a backend .env.
VITE_API_BASE_URL=http://localhost:5000
VITE_COGNITO_DOMAIN=quantile-auth.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=6e2925ql8rsidus8m4m45nsli0
VITE_COGNITO_REGION=ap-south-1
VITE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_LOGOUT_URI=http://localhost:5173/
